default_platform(:ios)

APP_ID = "com.firstrent.app"
TEAM_ID = "59GW7X6RA6"
VERSION = "1.0.0"
BUILD = "1"

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Create the FIRST RENT App Store Connect app"
  lane :bootstrap do
    connect_api_key
    sh("node #{File.expand_path('bootstrap-app.mjs', __dir__)}")
    UI.success("App #{APP_ID} ready")
  end

  desc "Build and upload FIRST RENT to TestFlight"
  lane :release do
    setup_ci
    api_key = connect_api_key

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain")
    keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    import_certificate(
      certificate_path: ENV.fetch("P12_PATH"),
      certificate_password: ENV.fetch("P12_PASSWORD"),
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "FIRSTRENT.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID,
      targets: ["FIRSTRENT"]
    )

    build_app(
      project: "FIRSTRENT.xcodeproj",
      scheme: "FIRSTRENT",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      skip_profile_detection: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{BUILD} MARKETING_VERSION=#{VERSION}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_ID => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      changelog: "FIRST RENT #{VERSION} (#{BUILD}) — le site client sur iPhone."
    )

    if ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true"
      submit_review
    end
  end

  desc "Send the App Store listing and submit the build"
  lane :submit_review do
    api_key = connect_api_key
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: VERSION,
      app_rating_config_path: File.expand_path("rating.json", __dir__),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      force: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: false,
        export_compliance_encryption_updated: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
